generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CHEF
  MANAGER
  STAFF
}

enum Position {
  COOK
  WAITER
  CASHIER
  CLEANER
}

enum Payment {
  CASH
  CARD
}

enum Channel {
  TELEGRAM
  WHATSAPP
}

enum DeliveryStatus {
  SENT
  DRY_RUN
  FAILED
}

model Branch {
  id        Int        @id @default(autoincrement())
  name      String
  city      String
  address   String
  phone     String
  email     String
  openedAt  DateTime   @default(now())
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  users     User[]
  orders    Order[]
  customers Customer[]
  tasks     Task[]
  shifts    Shift[]
  expenses  Expense[]
}

model User {
  id             Int        @id @default(autoincrement())
  fullName       String
  email          String     @unique
  phone          String
  /// Рақами WhatsApp (агар холӣ бошад — phone истифода мешавад)
  whatsapp       String     @default("")
  /// Номи корбарии Telegram бе @ (ё рақам)
  telegram       String     @default("")
  passwordHash   String
  role           Role
  position       Position?
  branchId       Int?
  branch         Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  salary         Int        @default(0)
  hiredAt        DateTime   @default(now())
  isActive       Boolean    @default(true)
  telegramChatId String?    @unique
  createdAt      DateTime   @default(now())
  orders         Order[]
  assignedTasks  Task[]     @relation("TaskAssignee")
  createdTasks   Task[]     @relation("TaskCreator")
  shifts         Shift[]
  expenses       Expense[]
  auditLogs      AuditLog[]
  alerts         Alert[]
  sentMessages     Message[]  @relation("MessageSender")
  receivedMessages Message[]  @relation("MessageRecipient")

  @@index([branchId])
}

model Product {
  id        Int         @id @default(autoincrement())
  name      String
  category  String
  emoji     String      @default("🍗")
  price     Decimal     @db.Decimal(10, 2)
  cost      Decimal     @db.Decimal(10, 2)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  items     OrderItem[]
}

model Order {
  id           Int         @id @default(autoincrement())
  branchId     Int
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  total        Decimal     @db.Decimal(12, 2)
  totalCost    Decimal     @db.Decimal(12, 2)
  payment      Payment     @default(CASH)
  customerId   Int?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount     Decimal     @default(0) @db.Decimal(12, 2)
  pointsEarned Int         @default(0)
  pointsUsed   Int         @default(0)
  items        OrderItem[]

  @@index([branchId, createdAt])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty       Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost  Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model Notification {
  id        Int            @id @default(autoincrement())
  channel   Channel
  to        String
  userId    Int?
  /// Кӣ паёмро дастӣ навишт (null — огоҳиномаи худкор)
  senderId  Int?
  text      String
  status    DeliveryStatus
  error     String?
  createdAt DateTime       @default(now())

  @@index([createdAt])
  @@index([senderId])
}

// ---------- CRM ----------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  SUPPLIES
  MARKETING
  OTHER
}

model Customer {
  id          Int       @id @default(autoincrement())
  fullName    String
  phone       String    @unique
  email       String?
  birthday    DateTime?
  branchId    Int?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  points      Int       @default(0)
  totalSpent  Decimal   @default(0) @db.Decimal(12, 2)
  visits      Int       @default(0)
  lastVisitAt DateTime?
  note        String    @default("")
  createdAt   DateTime  @default(now())
  orders      Order[]

  @@index([branchId])
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String     @default("")
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  branchId    Int?
  branch      Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assigneeId  Int?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById Int?
  createdBy   User?      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([branchId, status])
  @@index([assigneeId])
}

model Shift {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId   Int
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  checkInAt  DateTime?
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([branchId, startsAt])
  @@index([userId, startsAt])
}

model Expense {
  id          Int             @id @default(autoincrement())
  branchId    Int
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  note        String          @default("")
  createdById Int?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([branchId, date])
  @@index([date])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  Int?
  summary   String
  branchId  Int?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Alert {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon      String    @default("🔔")
  title     String
  body      String    @default("")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Чати дохилии сайт. Нусхаи паём ба WhatsApp/Telegram фиристода мешавад; ҷавобҳо аз онҳо ҳам ба ин ҷо меоянд.
model Message {
  id             Int       @id @default(autoincrement())
  senderId       Int
  sender         User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    Int
  recipient      User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  text           String
  /// Аз куҷо омад: WEB | TELEGRAM | WHATSAPP
  source         String    @default("WEB")
  /// Натиҷаи нусха ба WhatsApp/Telegram: SENT | DRY_RUN | FAILED | NOT_LINKED (null — фиристода нашуд)
  whatsappStatus String?
  telegramStatus String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([senderId, recipientId, createdAt])
}
