generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CHEF
  MANAGER
  STAFF
}

enum Position {
  COOK
  WAITER
  CASHIER
  CLEANER
  SELLER
  STOREKEEPER
}

enum Payment {
  CASH
  CARD
  /// Ба қарз: маблағ ба дафтари қарзи мизоҷ меравад
  DEBT
}

enum Channel {
  TELEGRAM
  WHATSAPP
}

/// Ҳолати бизнес: бизнеси нав то тасдиқи супер-админ кор намекунад
enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum DeliveryStatus {
  SENT
  DRY_RUN
  FAILED
}

/// Ширкати соҳибкор (тарабхона, мағозаи либос, хӯрокворӣ, сантехника…). Маълумоти ҳар ширкат аз дигарон пурра ҷудо аст.
model Organization {
  id            Int            @id @default(autoincrement())
  name          String
  /// BusinessType аз packages/shared: RESTAURANT | GROCERY | CLOTHING | PLUMBING | …
  type          String         @default("RESTAURANT")
  /// Корбаре (шеф), ки бизнесро сохт — як шеф метавонад якчанд бизнес дошта бошад
  ownerId       Int?
  /// Тавсифи кӯтоҳ барои мағозаи онлайн
  description   String         @default("")
  /// Дар бозори онлайн ба мизоҷон нишон дода шавад
  isPublic      Boolean        @default(true)
  /// Бизнеси нав PENDING аст; супер-админ тасдиқ (APPROVED), рад (REJECTED) ё баста (BLOCKED) мекунад
  status        OrgStatus      @default(PENDING)
  /// Сабаби рад/бастан (ба соҳиб нишон дода мешавад)
  statusNote    String         @default("")
  reviewedAt    DateTime?
  reviewedById  Int?
  /// Ширкати хизматии супер-админ (дар рӯйхати бизнесҳо нест)
  isPlatform    Boolean        @default(false)
  /// WhatsApp-и худи бизнес (Green-API). Холӣ — рақами умумии FilialHub истифода мешавад
  waInstanceId  String?
  /// Махфӣ: ҳеҷ гоҳ ба браузер фиристода намешавад
  waApiToken    String?
  waApiUrl      String?
  waMediaUrl    String?
  onlineOrders  OnlineOrder[]
  debtEntries   DebtEntry[]
  debtRequests  DebtRequest[]
  promoCodes    PromoCode[]
  reviews       Review[]
  storeViews    StoreView[]
  createdAt     DateTime       @default(now())
  branches      Branch[]
  users         User[]
  products      Product[]
  customers     Customer[]
  tasks         Task[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([status])
}

model Branch {
  id             Int           @id @default(autoincrement())
  organizationId Int
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  city           String
  address        String
  phone          String
  email          String
  openedAt       DateTime      @default(now())
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  users          User[]
  orders         Order[]
  customers      Customer[]
  tasks          Task[]
  shifts         Shift[]
  expenses       Expense[]
  onlineOrders   OnlineOrder[]
  stocks         BranchStock[]
  debtRequests   DebtRequest[]

  @@index([organizationId])
}

model User {
  id                  Int                @id @default(autoincrement())
  organizationId      Int
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName            String
  email               String             @unique
  phone               String
  /// Рақами WhatsApp (агар холӣ бошад — phone истифода мешавад)
  whatsapp            String             @default("")
  /// Номи корбарии Telegram бе @ (ё рақам)
  telegram            String             @default("")
  passwordHash        String
  role                Role
  position            Position?
  branchId            Int?
  branch              Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  salary              Int                @default(0)
  /// Рӯзи моҳ, ки маош дода мешавад (1–28)
  payDay              Int                @default(1)
  hiredAt             DateTime           @default(now())
  isActive            Boolean            @default(true)
  telegramChatId      String?            @unique
  /// Супер-админи платформа: ҳамаи бизнесҳоро мебинад ва бизнесҳои навро тасдиқ мекунад
  isSuperAdmin        Boolean            @default(false)
  /// Охирин бор кай сайт кушода буд («дида шуд 14:30» дар чат)
  lastSeenAt          DateTime?
  createdAt           DateTime           @default(now())
  orders              Order[]
  assignedTasks       Task[]             @relation("TaskAssignee")
  createdTasks        Task[]             @relation("TaskCreator")
  shifts              Shift[]
  expenses            Expense[]
  auditLogs           AuditLog[]
  alerts              Alert[]
  debtEntries         DebtEntry[]
  debtRequestsMade    DebtRequest[]      @relation("DebtRequester")
  debtRequestsDecided DebtRequest[]      @relation("DebtDecider")
  pushSubs            PushSubscription[]
  sentMessages        Message[]          @relation("MessageSender")
  receivedMessages    Message[]          @relation("MessageRecipient")
  media               Media[]
  outgoingCalls       Call[]             @relation("CallCaller")
  incomingCalls       Call[]             @relation("CallCallee")

  @@index([branchId])
  @@index([organizationId])
}

model Product {
  id             Int               @id @default(autoincrement())
  organizationId Int
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String
  emoji          String            @default("📦")
  /// Воҳиди ченак: дона, кг, литр, метр…
  unit           String            @default("дона")
  price          Decimal           @db.Decimal(10, 2)
  cost           Decimal           @db.Decimal(10, 2)
  /// Штрих-код (EAN/UPC) — сканер дар POS молро фавран меёбад
  barcode        String?
  /// Акси мол (WebP-и фишурда дар худи база)
  imageId        Int?
  image          Media?            @relation(fields: [imageId], references: [id], onDelete: SetNull)
  /// Боқимонда дар анбор; null — ҳисоб карда намешавад
  stock          Decimal?          @db.Decimal(12, 3)
  /// Огоҳӣ, вақте ки боқимонда то ин миқдор кам шавад
  lowStock       Decimal?          @db.Decimal(12, 3)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  items          OrderItem[]
  onlineItems    OnlineOrderItem[]
  branchStocks   BranchStock[]

  @@index([organizationId])
  @@index([organizationId, barcode])
}

model Order {
  id           Int         @id @default(autoincrement())
  branchId     Int
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  total        Decimal     @db.Decimal(12, 2)
  totalCost    Decimal     @db.Decimal(12, 2)
  payment      Payment     @default(CASH)
  customerId   Int?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount     Decimal     @default(0) @db.Decimal(12, 2)
  pointsEarned Int         @default(0)
  pointsUsed   Int         @default(0)
  items        OrderItem[]
  debtEntry    DebtEntry?
  /// Коди тахфиф, ки истифода шуд (нусха)
  promoCode    String?
  /// Рақами ягонаи фурӯш аз браузер (POS-и офлайн): ҳангоми фиристодани такрорӣ дубора сабт намешавад
  clientRef    String?     @unique

  @@index([branchId, createdAt])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Касрӣ ҳам мешавад (масалан 1,5 кг)
  qty       Decimal @db.Decimal(10, 3)
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost  Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model Notification {
  id             Int            @id @default(autoincrement())
  organizationId Int?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        Channel
  to             String
  userId         Int?
  /// Кӣ паёмро дастӣ навишт (null — огоҳиномаи худкор)
  senderId       Int?
  text           String
  status         DeliveryStatus
  error          String?
  createdAt      DateTime       @default(now())

  @@index([createdAt])
  @@index([senderId])
  @@index([organizationId])
}

// ---------- CRM ----------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  SUPPLIES
  MARKETING
  OTHER
}

model Customer {
  id             Int           @id @default(autoincrement())
  organizationId Int
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName       String
  phone          String
  email          String?
  birthday       DateTime?
  branchId       Int?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  points         Int           @default(0)
  totalSpent     Decimal       @default(0) @db.Decimal(12, 2)
  visits         Int           @default(0)
  lastVisitAt    DateTime?
  note           String        @default("")
  /// Қарзи ҳозира (ҷамъи DebtEntry); 0 — қарз нест
  debt           Decimal       @default(0) @db.Decimal(12, 2)
  /// Мӯҳлати пардохти қарз (наздиктарин); пас аз пардохти пурра — null
  debtDueAt      DateTime?
  /// Охирин ёдрас дар бораи қарз (WhatsApp)
  debtRemindedAt DateTime?
  /// Чати Telegram-и мизоҷ (бот: қарз ва ёдрас)
  telegramChatId String?
  createdAt      DateTime      @default(now())
  orders         Order[]
  debtEntries    DebtEntry[]
  debtRequests   DebtRequest[]

  @@unique([organizationId, phone])
  @@index([branchId])
  @@index([telegramChatId])
}

/// Огоҳӣ ба телефон/компютер (Web Push): як сатр барои ҳар браузери корманд
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Танзимоти система (масалан калидҳои VAPID, ки худкор сохта мешаванд)
model AppSetting {
  key   String @id
  value String
}

/// Боқимондаи мол дар анбори ҳар филиал (Product.stock — ҷамъи ҳамаи филиалҳо)
model BranchStock {
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  Int
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qty       Decimal @default(0) @db.Decimal(12, 3)

  @@id([productId, branchId])
  @@index([branchId])
}

/// Коди тахфиф / аксия: «WELCOME10» ё −20% дар рӯзи ҷумъа
model PromoCode {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Ҳамеша бо ҳарфҳои калон
  code           String
  /// Фоиз (1–90) ё маблағи собит — яке аз ду
  percent        Int?
  amount         Decimal?     @db.Decimal(12, 2)
  /// Ҳадди ақали харид
  minTotal       Decimal      @default(0) @db.Decimal(12, 2)
  /// Рӯзҳои ҳафта (1 = душанбе … 7 = якшанбе); холӣ — ҳар рӯз
  weekdays       Int[]
  startsAt       DateTime?
  endsAt         DateTime?
  /// Шумораи ҳадди истифода; null — бемаҳдуд
  maxUses        Int?
  uses           Int          @default(0)
  /// Дар куҷо: POS, бозори онлайн ё ҳарду
  pos            Boolean      @default(true)
  online         Boolean      @default(true)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, code])
}

/// Дафтари қарз: мусбат — мизоҷ ба қарз гирифт, манфӣ — қарзро пардохт кард
model DebtEntry {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     Int
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Фурӯш ба қарз дар POS (агар бошад)
  orderId        Int?         @unique
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount         Decimal      @db.Decimal(12, 2)
  /// Пардохти қарз: CASH ё CARD
  payment        Payment?
  /// Мӯҳлати пардохти ҳамин қарз (танҳо барои қарзи нав)
  dueAt          DateTime?
  note           String       @default("")
  userId         Int?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([customerId, createdAt])
}

model Task {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String       @default("")
  status         TaskStatus   @default(TODO)
  priority       Priority     @default(MEDIUM)
  dueDate        DateTime?
  branchId       Int?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assigneeId     Int?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    Int?
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([branchId, status])
  @@index([assigneeId])
}

model Shift {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId   Int
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  checkInAt  DateTime?
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([branchId, startsAt])
  @@index([userId, startsAt])
}

model Expense {
  id          Int             @id @default(autoincrement())
  branchId    Int
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  note        String          @default("")
  createdById Int?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([branchId, date])
  @@index([date])
}

model AuditLog {
  id             Int           @id @default(autoincrement())
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       Int?
  summary        String
  branchId       Int?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model Alert {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon      String    @default("🔔")
  title     String
  body      String    @default("")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Чати дохилии сайт. Нусхаи паём ба WhatsApp/Telegram фиристода мешавад; ҷавобҳо аз онҳо ҳам ба ин ҷо меоянд.
model Message {
  id             Int       @id @default(autoincrement())
  senderId       Int
  sender         User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    Int
  recipient      User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  text           String
  /// Аз куҷо омад: WEB | TELEGRAM | WHATSAPP
  source         String    @default("WEB")
  /// Натиҷаи нусха ба WhatsApp/Telegram: SENT | DRY_RUN | FAILED | NOT_LINKED (null — фиристода нашуд)
  whatsappStatus String?
  telegramStatus String?
  /// Чат дар кадом канал: WHATSAPP | TELEGRAM (null — зангҳо ва паёмҳои танҳо-сайт, дар ҳарду намоён)
  channel        String?
  /// TEXT | VOICE | VIDEO_NOTE | CALL
  kind           String    @default("TEXT")
  mediaId        Int?
  media          Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  durationSec    Int?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([senderId, recipientId, createdAt])
  @@index([channel])
}

/// Файли паёми овозӣ ё видеоӣ (дар худи база — барои Render хотираи диск лозим нест)
model Media {
  id        Int       @id @default(autoincrement())
  ownerId   Int?
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime  @default(now())
  messages  Message[]
  products  Product[]
}

/// Занги аудио/видео (WebRTC). Пешниҳод ва ҷавоби SDP дар ҳамин ҷо — сервери алоҳидаи сигнал лозим нест.
model Call {
  id         Int       @id @default(autoincrement())
  callerId   Int
  caller     User      @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId   Int
  callee     User      @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  video      Boolean   @default(false)
  /// RINGING | ACTIVE | ENDED | DECLINED | MISSED | CANCELLED
  status     String    @default("RINGING")
  offer      String?
  answer     String?
  createdAt  DateTime  @default(now())
  answeredAt DateTime?
  endedAt    DateTime?

  @@index([calleeId, status])
}

// ---------- Бозори онлайн: мизоҷон ва фармоишҳои онҳо ----------

/// Мизоҷи онлайн — худаш сабти ном мекунад ва аз ҳар мағоза фармоиш медиҳад (ба ширкат вобаста нест)
model Client {
  id             Int           @id @default(autoincrement())
  fullName       String
  email          String        @unique
  phone          String
  address        String        @default("")
  passwordHash   String
  /// Чати Telegram (бот: ҳолати фармоишҳо)
  telegramChatId String?
  createdAt      DateTime      @default(now())
  orders         OnlineOrder[]
  reviews        Review[]

  @@index([telegramChatId])
}

enum OnlineOrderStatus {
  NEW
  ACCEPTED
  DELIVERING
  DELIVERED
  CANCELLED
}

model OnlineOrder {
  id             Int               @id @default(autoincrement())
  /// null — фармоиш аз миз (QR) бе сабти ном
  clientId       Int?
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Рақами миз барои фармоиш аз QR дар тарабхона
  table          String?
  organizationId Int
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       Int?
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status         OnlineOrderStatus @default(NEW)
  /// Тарзи пардохт, ки мизоҷ интихоб кард; пул ҳангоми гирифтани мол дода мешавад
  payment        Payment           @default(CASH)
  address        String
  phone          String
  note           String            @default("")
  total          Decimal           @db.Decimal(12, 2)
  /// Тахфиф аз коди промо (аллакай аз total кам карда шуд)
  discount       Decimal           @default(0) @db.Decimal(12, 2)
  promoCode      String?
  /// Фурӯше, ки ҳангоми «Расонида шуд» сохта мешавад (ба омор медарояд)
  saleOrderId    Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          OnlineOrderItem[]
  review         Review?

  @@index([organizationId, status])
  @@index([clientId, createdAt])
}

model OnlineOrderItem {
  id            Int         @id @default(autoincrement())
  onlineOrderId Int
  onlineOrder   OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  productId     Int?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Нусхаи ном ва нарх дар лаҳзаи фармоиш
  name          String
  emoji         String
  unit          String
  qty           Decimal     @db.Decimal(10, 3)
  unitPrice     Decimal     @db.Decimal(10, 2)

  @@index([onlineOrderId])
}

/// Шумораи кушодани саҳифаи мағоза дар бозори онлайн, рӯз ба рӯз (статистикаи ройгон, бе cookie)
model StoreView {
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Рӯз бо вақти маҳаллӣ (UTC 00:00-и ҳамон сана)
  day            DateTime     @db.Date
  views          Int          @default(0)

  @@id([organizationId, day])
}

/// Баҳои мизоҷ ба мағоза (1–5 ⭐) — танҳо пас аз фармоиши расонидашуда, як баҳо барои як фармоиш
model Review {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       Int
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  onlineOrderId  Int          @unique
  onlineOrder    OnlineOrder  @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  rating         Int
  text           String       @default("")
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

enum DebtRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Дархости қарз аз кассир: то тасдиқи менеҷер (ё шеф) қарз дода намешавад
model DebtRequest {
  id             Int               @id @default(autoincrement())
  organizationId Int
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       Int
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId     Int
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount         Decimal           @db.Decimal(12, 2)
  note           String            @default("")
  /// Мӯҳлати пардохт, ки кассир пешниҳод кард
  dueAt          DateTime?
  /// Фурӯш ба қарз аз POS: сабади пурра (CreateOrderDto); пас аз тасдиқ фурӯш сабт мешавад
  sale           Json?
  status         DebtRequestStatus @default(PENDING)
  requestedById  Int?
  requestedBy    User?             @relation("DebtRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById    Int?
  decidedBy      User?             @relation("DebtDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  /// Фурӯше, ки пас аз тасдиқ сохта шуд
  orderId        Int?
  createdAt      DateTime          @default(now())

  @@index([organizationId, status])
  @@index([branchId, status])
}
