generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CHEF
  MANAGER
  STAFF
}

enum Position {
  COOK
  WAITER
  CASHIER
  CLEANER
  SELLER
  STOREKEEPER
}

enum Payment {
  CASH
  CARD
}

enum Channel {
  TELEGRAM
  WHATSAPP
}

enum DeliveryStatus {
  SENT
  DRY_RUN
  FAILED
}

/// Ширкати соҳибкор (тарабхона, мағозаи либос, хӯрокворӣ, сантехника…). Маълумоти ҳар ширкат аз дигарон пурра ҷудо аст.
model Organization {
  id            Int            @id @default(autoincrement())
  name          String
  /// BusinessType аз packages/shared: RESTAURANT | GROCERY | CLOTHING | PLUMBING | …
  type          String         @default("RESTAURANT")
  /// Корбаре (шеф), ки бизнесро сохт — як шеф метавонад якчанд бизнес дошта бошад
  ownerId       Int?
  /// Тавсифи кӯтоҳ барои мағозаи онлайн
  description   String         @default("")
  /// Дар бозори онлайн ба мизоҷон нишон дода шавад
  isPublic      Boolean        @default(true)
  onlineOrders  OnlineOrder[]
  createdAt     DateTime       @default(now())
  branches      Branch[]
  users         User[]
  products      Product[]
  customers     Customer[]
  tasks         Task[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model Branch {
  id             Int           @id @default(autoincrement())
  organizationId Int
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  city           String
  address        String
  phone          String
  email          String
  openedAt       DateTime      @default(now())
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  users          User[]
  orders         Order[]
  customers      Customer[]
  tasks          Task[]
  shifts         Shift[]
  expenses       Expense[]
  onlineOrders   OnlineOrder[]

  @@index([organizationId])
}

model User {
  id               Int          @id @default(autoincrement())
  organizationId   Int
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName         String
  email            String       @unique
  phone            String
  /// Рақами WhatsApp (агар холӣ бошад — phone истифода мешавад)
  whatsapp         String       @default("")
  /// Номи корбарии Telegram бе @ (ё рақам)
  telegram         String       @default("")
  passwordHash     String
  role             Role
  position         Position?
  branchId         Int?
  branch           Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  salary           Int          @default(0)
  /// Рӯзи моҳ, ки маош дода мешавад (1–28)
  payDay           Int          @default(1)
  hiredAt          DateTime     @default(now())
  isActive         Boolean      @default(true)
  telegramChatId   String?      @unique
  createdAt        DateTime     @default(now())
  orders           Order[]
  assignedTasks    Task[]       @relation("TaskAssignee")
  createdTasks     Task[]       @relation("TaskCreator")
  shifts           Shift[]
  expenses         Expense[]
  auditLogs        AuditLog[]
  alerts           Alert[]
  sentMessages     Message[]    @relation("MessageSender")
  receivedMessages Message[]    @relation("MessageRecipient")
  media            Media[]
  outgoingCalls    Call[]       @relation("CallCaller")
  incomingCalls    Call[]       @relation("CallCallee")

  @@index([branchId])
  @@index([organizationId])
}

model Product {
  id             Int               @id @default(autoincrement())
  organizationId Int
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String
  emoji          String            @default("📦")
  /// Воҳиди ченак: дона, кг, литр, метр…
  unit           String            @default("дона")
  price          Decimal           @db.Decimal(10, 2)
  cost           Decimal           @db.Decimal(10, 2)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  items          OrderItem[]
  onlineItems    OnlineOrderItem[]

  @@index([organizationId])
}

model Order {
  id           Int         @id @default(autoincrement())
  branchId     Int
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId       Int?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  total        Decimal     @db.Decimal(12, 2)
  totalCost    Decimal     @db.Decimal(12, 2)
  payment      Payment     @default(CASH)
  customerId   Int?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount     Decimal     @default(0) @db.Decimal(12, 2)
  pointsEarned Int         @default(0)
  pointsUsed   Int         @default(0)
  items        OrderItem[]

  @@index([branchId, createdAt])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  /// Касрӣ ҳам мешавад (масалан 1,5 кг)
  qty       Decimal @db.Decimal(10, 3)
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost  Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model Notification {
  id             Int            @id @default(autoincrement())
  organizationId Int?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel        Channel
  to             String
  userId         Int?
  /// Кӣ паёмро дастӣ навишт (null — огоҳиномаи худкор)
  senderId       Int?
  text           String
  status         DeliveryStatus
  error          String?
  createdAt      DateTime       @default(now())

  @@index([createdAt])
  @@index([senderId])
  @@index([organizationId])
}

// ---------- CRM ----------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  SUPPLIES
  MARKETING
  OTHER
}

model Customer {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName       String
  phone          String
  email          String?
  birthday       DateTime?
  branchId       Int?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  points         Int          @default(0)
  totalSpent     Decimal      @default(0) @db.Decimal(12, 2)
  visits         Int          @default(0)
  lastVisitAt    DateTime?
  note           String       @default("")
  createdAt      DateTime     @default(now())
  orders         Order[]

  @@unique([organizationId, phone])
  @@index([branchId])
}

model Task {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String       @default("")
  status         TaskStatus   @default(TODO)
  priority       Priority     @default(MEDIUM)
  dueDate        DateTime?
  branchId       Int?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assigneeId     Int?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    Int?
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([branchId, status])
  @@index([assigneeId])
}

model Shift {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId   Int
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  checkInAt  DateTime?
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([branchId, startsAt])
  @@index([userId, startsAt])
}

model Expense {
  id          Int             @id @default(autoincrement())
  branchId    Int
  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  note        String          @default("")
  createdById Int?
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([branchId, date])
  @@index([date])
}

model AuditLog {
  id             Int           @id @default(autoincrement())
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       Int?
  summary        String
  branchId       Int?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model Alert {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  icon      String    @default("🔔")
  title     String
  body      String    @default("")
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

/// Чати дохилии сайт. Нусхаи паём ба WhatsApp/Telegram фиристода мешавад; ҷавобҳо аз онҳо ҳам ба ин ҷо меоянд.
model Message {
  id             Int       @id @default(autoincrement())
  senderId       Int
  sender         User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    Int
  recipient      User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  text           String
  /// Аз куҷо омад: WEB | TELEGRAM | WHATSAPP
  source         String    @default("WEB")
  /// Натиҷаи нусха ба WhatsApp/Telegram: SENT | DRY_RUN | FAILED | NOT_LINKED (null — фиристода нашуд)
  whatsappStatus String?
  telegramStatus String?
  /// Чат дар кадом канал: WHATSAPP | TELEGRAM (null — зангҳо ва паёмҳои танҳо-сайт, дар ҳарду намоён)
  channel        String?
  /// TEXT | VOICE | VIDEO_NOTE | CALL
  kind           String    @default("TEXT")
  mediaId        Int?
  media          Media?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  durationSec    Int?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([senderId, recipientId, createdAt])
  @@index([channel])
}

/// Файли паёми овозӣ ё видеоӣ (дар худи база — барои Render хотираи диск лозим нест)
model Media {
  id        Int       @id @default(autoincrement())
  ownerId   Int?
  owner     User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime  @default(now())
  messages  Message[]
}

/// Занги аудио/видео (WebRTC). Пешниҳод ва ҷавоби SDP дар ҳамин ҷо — сервери алоҳидаи сигнал лозим нест.
model Call {
  id         Int       @id @default(autoincrement())
  callerId   Int
  caller     User      @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId   Int
  callee     User      @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  video      Boolean   @default(false)
  /// RINGING | ACTIVE | ENDED | DECLINED | MISSED | CANCELLED
  status     String    @default("RINGING")
  offer      String?
  answer     String?
  createdAt  DateTime  @default(now())
  answeredAt DateTime?
  endedAt    DateTime?

  @@index([calleeId, status])
}

// ---------- Бозори онлайн: мизоҷон ва фармоишҳои онҳо ----------

/// Мизоҷи онлайн — худаш сабти ном мекунад ва аз ҳар мағоза фармоиш медиҳад (ба ширкат вобаста нест)
model Client {
  id           Int           @id @default(autoincrement())
  fullName     String
  email        String        @unique
  phone        String
  address      String        @default("")
  passwordHash String
  createdAt    DateTime      @default(now())
  orders       OnlineOrder[]
}

enum OnlineOrderStatus {
  NEW
  ACCEPTED
  DELIVERING
  DELIVERED
  CANCELLED
}

model OnlineOrder {
  id             Int               @id @default(autoincrement())
  clientId       Int
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organizationId Int
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       Int?
  branch         Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status         OnlineOrderStatus @default(NEW)
  /// Тарзи пардохт, ки мизоҷ интихоб кард; пул ҳангоми гирифтани мол дода мешавад
  payment        Payment           @default(CASH)
  address        String
  phone          String
  note           String            @default("")
  total          Decimal           @db.Decimal(12, 2)
  /// Фурӯше, ки ҳангоми «Расонида шуд» сохта мешавад (ба омор медарояд)
  saleOrderId    Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  items          OnlineOrderItem[]

  @@index([organizationId, status])
  @@index([clientId, createdAt])
}

model OnlineOrderItem {
  id            Int         @id @default(autoincrement())
  onlineOrderId Int
  onlineOrder   OnlineOrder @relation(fields: [onlineOrderId], references: [id], onDelete: Cascade)
  productId     Int?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Нусхаи ном ва нарх дар лаҳзаи фармоиш
  name          String
  emoji         String
  unit          String
  qty           Decimal     @db.Decimal(10, 3)
  unitPrice     Decimal     @db.Decimal(10, 2)

  @@index([onlineOrderId])
}
