# PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/filialhub"

PORT=4100
JWT_SECRET="change-me-to-a-long-random-string"
WEB_ORIGIN="http://localhost:3100"

# Минтақаи вақт (Тоҷикистон UTC+5)
TIMEZONE="Asia/Dushanbe"

# Telegram: токенро аз @BotFather гиред. Холӣ бошад — паёмҳо танҳо дар лог/саҳифаи «Интегратсияҳо» нишон дода мешаванд.
TELEGRAM_BOT_TOKEN=""
# Дар Render бот худкор бо webhook кор мекунад (RENDER_EXTERNAL_URL). Дар компютер — polling;
# агар ҳамон бот дар Render кор кунад, дар компютер токени боти ДИГАРро гузоред (вагарна webhook-и Render нест мешавад).
# TELEGRAM_MODE="polling" — ҳатман polling; TELEGRAM_WEBHOOK_URL — суроғаи API барои webhook берун аз Render.
# TELEGRAM_WEBHOOK_URL="https://your-api.example.com"

# WhatsApp Cloud API (Meta for Developers → WhatsApp → API Setup)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Ҷавобҳо аз WhatsApp ба чати сайт: Meta → WhatsApp → Configuration → Webhook
# Callback URL: https://<api>/api/whatsapp/webhook, Verify token: ҳамин қимат
WHATSAPP_VERIFY_TOKEN=""
# Meta → App settings → Basic → App secret: имзои webhook санҷида мешавад (тавсия дода мешавад)
WHATSAPP_APP_SECRET=""
# Шаблони тасдиқшуда дар Meta (WhatsApp Manager → Message templates), матн: «{{1}}». Пас аз 24 соат паём бо он меравад.
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="ru"

# Ҳисоботи рӯзона (cron: сония дақиқа соат рӯз моҳ рӯзи_ҳафта) — пешфарз ҳар рӯз соати 22:00
DAILY_REPORT_CRON="0 0 22 * * *"

# Супер-админи платформа: бизнесҳои навро тасдиқ мекунад (сайт → «Супер-админ», бот → /pending, /approve ID).
# Почтаҳо бо вергул. Агар корбар бо ин почта аллакай бошад — супер-админ мешавад;
# агар набошад — бо SUPERADMIN_PASSWORD (камаш 8 аломат) ҳисоби нав сохта мешавад.
SUPERADMIN_EMAILS=""
SUPERADMIN_PASSWORD=""
# Рақами телефон/WhatsApp-и супер-админ (барои хабарҳо дар WhatsApp)
SUPERADMIN_PHONE=""
