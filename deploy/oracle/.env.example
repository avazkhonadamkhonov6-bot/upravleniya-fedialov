# Ин файлро setup.sh ба .env нусха мекунад. .env ба git намеравад — паролҳо танҳо дар сервер.

# Суроғаи сайт бе https://. Бе домени худ: <IP бо тире>.sslip.io (ройгон), масалан 141-147-1-2.sslip.io
DOMAIN=

# Ҳамон базае, ки Render истифода мебарад (Neon) — бо ?sslmode=require
DATABASE_URL=
# setup.sh худкор месозад
JWT_SECRET=
TIMEZONE=Asia/Dushanbe
DAILY_REPORT_CRON=0 0 22 * * *

# Ҳама дигар — мисли Render → filialhub-web → Environment (холӣ — хомӯш)
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
GREENAPI_API_URL=
GREENAPI_PARTNER_TOKEN=
GREENAPI_PARTNER_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ru
SUPERADMIN_EMAILS=
SUPERADMIN_PASSWORD=
SUPERADMIN_PHONE=
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
